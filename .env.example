# Copy to .env.local for local overrides (git-ignored).

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# Development-only opt-in to the retained local-cache adapter (reads
# public/data/real/ directly in the browser instead of calling the backend).
# Never set this in a production build. Leave unset/false to use the API.
VITE_USE_LOCAL_CACHE_ADAPTER=false
